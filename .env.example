# ========================================================
# DigitalHub Marketplace Environment Variables
# ========================================================

# Supabase Configuration (Optional - Defaults to local storage engine if not provided)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock Payment Sandbox mode (enabled by default for MVP)
NEXT_PUBLIC_PAYMENT_MODE=sandbox
